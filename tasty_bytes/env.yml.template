env_config:
  default_environment: workspace
  environments:
    - name: workspace   # used by developers working in Snowsight Workspaces — always dynamic, never overwritten
      env:
        DBT_CURRENT_WH: "{{ select CURRENT_WAREHOUSE() }}"
        DBT_CURRENT_DB: "{{ select CURRENT_DATABASE() }}"
        DBT_CURRENT_SCHEMA: "{{ select CURRENT_USER() }}"
        DBT_CURRENT_ROLE: "{{ select CURRENT_ROLE() }}"

    - name: ${TARGET_ENV}   # placeholder — filled in by CI/CD at deploy time
      env:
        DBT_CURRENT_WH: ${SNOWFLAKE_WAREHOUSE}
        DBT_CURRENT_DB: ${SNOWFLAKE_DATABASE}
        DBT_CURRENT_SCHEMA: ${SNOWFLAKE_SCHEMA}
        DBT_CURRENT_ROLE: ${SNOWFLAKE_ROLE}